# ── Site URL Configuration ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.optivirads.com

# ── Analytics & Tag Management ───────────────────────────────────────────────
# Google Tag Manager Container ID (e.g., GTM-XXXXXXX)
# All analytics (GA4), advertising pixels (Meta, Google Ads), and custom tracking are managed via GTM
NEXT_PUBLIC_GTM_ID=

# ── Headless WordPress API (Optional) ────────────────────────────────────────
# Headless CMS REST API endpoint
NEXT_PUBLIC_WORDPRESS_API_URL=https://cms.optivirads.com

# ── Contact Form Email Notifications (SMTP) ──────────────────────────────────
# Required for form submissions via /api/contact
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=services@optivirads.com

# ── Google Maps & Places API (Optional) ──────────────────────────────────────
# For live review sync from Google Business Profile
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ── Google Sheets Lead Capture (Optional) ─────────────────────────────────────
# Google Apps Script Web App URL for automatic form submission logging
GOOGLE_SHEET_WEBAPP_URL=

