# ── Site URL Configuration ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.optivirads.com

# ── Search Engine Site Verification ──────────────────────────────────────────
# Replace with your verification token from Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code-here
# Optional Bing Webmaster Tools verification code
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Optional Yandex Webmaster verification code
NEXT_PUBLIC_YANDEX_VERIFICATION=

# ── Analytics & Conversion Pixels (Optional) ─────────────────────────────────
# Google Tag Manager Container ID (e.g., GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=
# Direct Google Analytics 4 ID (e.g., G-XXXXXXXXXX) if not managed via GTM
NEXT_PUBLIC_GA4_ID=
# Meta Pixel ID (e.g., 123456789012345) if not managed via GTM
NEXT_PUBLIC_META_PIXEL_ID=

# ── Google Maps & Places API (Optional) ──────────────────────────────────────
# For live review sync from Google Business Profile
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ── Headless WordPress API (Optional) ────────────────────────────────────────
# Headless CMS REST API endpoint
NEXT_PUBLIC_WORDPRESS_API_URL=https://cms.optivirads.com
